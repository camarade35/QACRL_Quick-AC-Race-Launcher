{
  "name": "qacrl_quick_ac_race_launcher",
  "version": "1.2.8",
  "description": "QACRL - Quick AC Race Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^8.1.0",
    "systeminformation": "^5.21.15"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qacrl.launcher",
    "productName": "QACRL",
    "win": {
      "target": "nsis",
      "icon": "public/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}